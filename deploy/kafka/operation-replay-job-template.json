{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "generateName": "kafka-event-operation-",
    "namespace": "car-community"
  },
  "spec": {
    "activeDeadlineSeconds": 300,
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "car-community",
          "app.kubernetes.io/component": "kafka-event-operation"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "enableServiceLinks": false,
        "containers": [
          {
            "name": "operation",
            "image": "registry.invalid/car-community",
            "args": [
              "--command=kafka-events",
              "--mode=replay",
              "--event-ids=REQUIRED",
              "--reason=REQUIRED"
            ],
            "env": [
              {
                "name": "SPRING_PROFILES_ACTIVE",
                "value": "production"
              },
              {
                "name": "KAFKA_BOOTSTRAP_SERVERS",
                "value": "car-community-kafka-bootstrap:9093"
              },
              {
                "name": "KAFKA_REPLAY_SECURITY_PROTOCOL",
                "value": "SSL"
              },
              {
                "name": "KAFKA_CA_PATH",
                "value": "/etc/car-community/kafka/ca/ca.crt"
              },
              {
                "name": "KAFKA_REPLAY_KEYSTORE_PATH",
                "value": "/etc/car-community/kafka/replay/user.p12"
              },
              {
                "name": "KAFKA_REPLAY_KEYSTORE_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "community-replay",
                    "key": "user.password"
                  }
                }
              },
              {
                "name": "DB_URL",
                "valueFrom": {
                  "configMapKeyRef": {
                    "name": "car-community-config",
                    "key": "DB_URL"
                  }
                }
              },
              {
                "name": "DB_USERNAME",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "car-community-db-runtime",
                    "key": "DB_USERNAME"
                  }
                }
              },
              {
                "name": "DB_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "car-community-db-runtime",
                    "key": "DB_PASSWORD"
                  }
                }
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "kafka-ca",
                "mountPath": "/etc/car-community/kafka/ca",
                "readOnly": true
              },
              {
                "name": "kafka-replay",
                "mountPath": "/etc/car-community/kafka/replay",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {}
          },
          {
            "name": "kafka-ca",
            "secret": {
              "secretName": "car-community-cluster-ca-cert",
              "items": [
                {
                  "key": "ca.crt",
                  "path": "ca.crt"
                }
              ]
            }
          },
          {
            "name": "kafka-replay",
            "secret": {
              "secretName": "community-replay",
              "items": [
                {
                  "key": "user.p12",
                  "path": "user.p12"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
