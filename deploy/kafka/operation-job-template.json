{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "generateName": "kafka-event-operation-",
    "namespace": "car-community"
  },
  "spec": {
    "activeDeadlineSeconds": 300,
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "car-community",
          "app.kubernetes.io/component": "kafka-event-operation"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "enableServiceLinks": false,
        "containers": [
          {
            "name": "operation",
            "image": "registry.invalid/car-community",
            "args": [
              "--command=kafka-events",
              "--mode=replay",
              "--event-ids=REQUIRED",
              "--reason=REQUIRED"
            ],
            "env": [
              {
                "name": "SPRING_PROFILES_ACTIVE",
                "value": "production"
              },
              {
                "name": "DB_URL",
                "valueFrom": {
                  "configMapKeyRef": {
                    "name": "car-community-config",
                    "key": "DB_URL"
                  }
                }
              },
              {
                "name": "DB_USERNAME",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "car-community-db-runtime",
                    "key": "DB_USERNAME"
                  }
                }
              },
              {
                "name": "DB_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "car-community-db-runtime",
                    "key": "DB_PASSWORD"
                  }
                }
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {}
          }
        ]
      }
    }
  }
}
