# 로컬 .env에 작성할 환경변수 key 목록입니다. 이 파일의 값은 모두 비워 둡니다.

# --
# Infra
## PostgreSQL Database
### Local
DB_USERNAME=
DB_PASSWORD=
# DB_URL을 생략하면 application.yaml의 localhost 기본값을 사용합니다.
DB_URL=

### Staging bootstrap
# JDBC URL은 staging manifest와 bootstrap script에 고정하며 .env에서 입력받지 않습니다.
# Username은 bootstrap script의 carmunity_runtime과 carmunity_migrator로 고정합니다.
# 두 password는 비어 있거나 공백뿐인 값·줄바꿈을 허용하지 않으며 서로 및 현재 RDS master password와 달라야 합니다.
STG_DB_RUNTIME_PASSWORD=
STG_DB_MIGRATOR_PASSWORD=


# --
# Authentication
## Local
# 설정할 경우 issuer는 비어 있지 않아야 하고 access token TTL은 양의 Duration이어야 합니다.
AUTH_JWT_ISSUER=
AUTH_JWT_ACCESS_TOKEN_TTL=
# 두 HMAC secret은 각각 32 bytes 이상이며 서로 달라야 합니다.
AUTH_JWT_HMAC_SECRET=
AUTH_LOGIN_IDENTIFIER_HMAC_SECRET=

## Staging bootstrap
# 두 staging HMAC secret은 각각 32 bytes 이상이며 서로 달라야 합니다.
STG_AUTH_JWT_HMAC_SECRET=
STG_AUTH_LOGIN_IDENTIFIER_HMAC_SECRET=
STG_COMMUNITY_CURSOR_HMAC_SECRET=


# --
# Tooling
## SonarQube
# SonarQube Cloud 분석 제출과 private project의 읽기 전용 Web API 조회가 모두 가능한 token을 사용합니다.
SONAR_TOKEN=
SONAR_ORGANIZATION=
SONAR_PROJECT_KEY=


# --
# Notification
## Local
# Email notification을 사용하면 아래 다섯 값을 모두 설정해야 합니다.
RESEND_API_KEY=
# 인증된 발신자 email을 사용합니다.
NOTIFICATION_EMAIL_FROM=
# 세 base URL은 http 또는 https URL이어야 합니다.
EMAIL_VERIFICATION_BASE_URL=
ADMIN_INVITATION_BASE_URL=
PASSWORD_RESET_BASE_URL=

## Staging
# Staging application이 사용할 Resend API key는 비어 있거나 공백뿐인 값·줄바꿈을 허용하지 않습니다.
STG_RESEND_API_KEY=
COMMUNITY_ENABLED=
COMMUNITY_CURSOR_HMAC_SECRET=
COMMUNITY_TRUSTED_PROXY_CIDRS=
COMMUNITY_MEDIA_BUCKET=
COMMUNITY_MEDIA_REGION=
COMMUNITY_MEDIA_ROLE_ARN=
COMMUNITY_MEDIA_WEB_IDENTITY_TOKEN_PATH=
